<?xml version="1.0" encoding="utf-8"?>
<!-- The notification icon is looked up by name from Dart (AudioServiceConfig),
     so the release resource shrinker can't see it's used. Without this the icon
     is stripped and Android kills the app when the playback notification starts. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_sonar" />
